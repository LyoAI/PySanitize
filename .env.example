# LLM API keys — referenced via ${VAR} placeholders in config/llm/*.yaml.
# Copy this file to `.env` and fill in the keys you actually use.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# MinerU backend: pipeline (CPU) | vlm-engine (GPU) | hybrid-engine (GPU)
MINERU_BACKEND=pipeline

# Root for downloaded local models (YuNet face-detection ONNX, etc.)
MODELS_DIR=~/Models

# Per-call LLM request timeout (seconds)
LLM_TIMEOUT_S=180
