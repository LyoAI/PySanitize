# Copy to .env and fill in what you use. Everything here is optional —
# pysanitize works out of the box without it (rules detection is fully offline).

# --- LLM API keys (config/llm/<model>.yaml expands ${VAR} placeholders) ---
DEEPSEEK_API_KEY=        # deepseek-v4-flash (default model)
DASHSCOPE_API_KEY=       # qwen3-max / qwen3.6-27b

# --- MinerU (document parsing) ---
MINERU_BACKEND=pipeline  # pipeline (CPU) | vlm-engine / hybrid-engine (GPU)

# --- Local model downloads (YuNet ONNX, ...) ---
# MODELS_DIR=~/Models

# --- LLM request tuning ---
# LLM_TIMEOUT_S=180      # per-call timeout in seconds

# --- Recoverable masking passphrase (optional; else --recover-key / .recover.key) ---
# PYSANITIZE_RECOVER_KEY=
